        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウのタイトルなど、システムが表示する文字はMacFanの再起動後に切り替わります。"
          }
        }
      }
    },
    "With nothing selected, the menu bar shows a fan icon." : {
