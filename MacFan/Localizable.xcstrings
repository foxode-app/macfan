    "For reference, on an %@ macOS started raising the fan at about %lld°C and, under a sustained full CPU load, held about %lld°C with the fan at %lld rpm (%lld%% of its maximum)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For reference, on an %@ macOS started raising the fan at about %lld°C and, under a sustained full CPU load, held about %lld°C with the fan at %lld rpm (%lld%% of its maximum)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目安：%1$@では、macOSは約%2$lld°Cでファンを上げ始め、全コアの高負荷が続くと約%3$lld°C・%4$lld rpm（最大の%5$lld%%）で安定しました。"
          }
        }
      }
    },
    "GPU Temperature" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
