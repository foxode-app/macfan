    "Based on Temperature" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Based on Temperature"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "温度による制御"
          }
        }
      }
    },
    "Below the start temperature, macOS controls the fans. Above it, the speed rises from the fan's minimum and reaches the maximum speed at the maximum temperature." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Below the start temperature, macOS controls the fans. Above it, the speed rises from the fan's minimum and reaches the maximum speed at the maximum temperature."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上がり始める温度までは、macOSがファンを制御します。それを超えると最低回転数から上がり始め、最大温度で最大回転数に達します。"
          }
        }
      }
    },
