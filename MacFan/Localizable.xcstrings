{
  "sourceLanguage" : "en",
  "strings" : {
    "Above %lld°C, the fans always go back to macOS." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Above %lld°C, the fans always go back to macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld°Cを超えると、設定にかかわらずmacOSの制御に戻します。"
          }
        }
      }
    },
    "Auto" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
