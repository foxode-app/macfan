    },
    "Gradual changes move the speed by about %lld rpm per second, close to what macOS does." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradual changes move the speed by about %lld rpm per second, close to what macOS does."
