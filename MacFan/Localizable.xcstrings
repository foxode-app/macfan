    "To control the fans, allow MacFan in System Settings → General → Login Items & Extensions." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To control the fans, allow MacFan in System Settings → General → Login Items & Extensions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファンを制御するには、「システム設定」→「一般」→「ログイン項目と機能拡張」でMacFanを許可してください。"
          }
        }
      }
    },
